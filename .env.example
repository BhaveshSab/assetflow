# ---------------------------------------------------------------------------
# AssetFlow frontend environment — TEMPLATE (safe to commit)
#
# Copy to `.env.local` for local overrides; set the same keys in your hosting
# provider's project settings for deployments. Vite inlines every VITE_* value
# at BUILD time, so changing one requires a rebuild / redeploy.
# ---------------------------------------------------------------------------

# Base URL of the AssetFlow API, including the /api prefix.
#   • Local:  http://localhost:4000/api  (the backend's default port)
#   • Prod:   https://<your-api-project>.vercel.app/api
# Defaults to http://localhost:4000/api when unset.
VITE_API_BASE_URL="http://localhost:4000/api"
