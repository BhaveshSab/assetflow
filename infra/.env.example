# ---------------------------------------------------------------------------
# The environment of the AssetFlow stack.
#
#   cp infra/.env.example infra/.env
#
# `infra/.env` is git-ignored — never commit a filled-in copy.
# ---------------------------------------------------------------------------

# ------------------------------------------------------- the public address
# What the blackbox exporter probes to read the certificate's expiry date, and
# what ends up in the TlsCertificateExpiringSoon alert. Leave it unset and the
# default `https://nginx` is used: Prometheus probes nginx over the internal
# Docker network, which still returns the real certificate (hostname
# verification is skipped — see infra/blackbox/blackbox.yml).
#
# Set it to the public URL (https://example.org) to probe the way a browser
# does. It is read at start-up by infra/prometheus/render.sh.
PUBLIC_BASE_URL=https://nginx

# ------------------------------------------------------------- the database
POSTGRES_USER=assetflow
POSTGRES_PASSWORD=change-me-a-long-database-password
POSTGRES_DB=assetflow

# The URL the **host** uses to reach the database (the seed, a psql session
# run outside Docker). The containers build the same URL themselves from the
# three variables above — `docker-compose.yml` passes it to the api and migrate
# services — so this line is not what makes the stack work.
#
# It still has to be *correct*, because `cp infra/.env.example infra/.env` is
# the documented first step: **the password here must equal
# POSTGRES_PASSWORD**, or a host-side command will fail to authenticate.
# Change both lines together.
DATABASE_URL=postgresql://assetflow:change-me-a-long-database-password@postgres:5432/assetflow

# --------------------------------------------------------- the shared store
# The password of the Redis container. The API uses it for the shared
# rate-limit counters.
REDIS_PASSWORD=change-me-a-long-redis-password

# ------------------------------------------------ the API rate limit
# 300 requests per 60 s per authenticated user (per address when there is no
# valid token). The **block** value is not decoration: the throttler only
# answers 429 once a client is over the limit *and* a block duration is set,
# so leaving it at 0 turns the limiter into a counter that never refuses
# anything. THROTTLE_BLOCK_MS is how long the refusal lasts.
# THROTTLE_LIMIT=300
# THROTTLE_TTL=60000
# THROTTLE_BLOCK_MS=60000

# --------------------------------------------------------------- the secret
# The key the JWTs are signed with. At least 32 characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars

# ------------------------------------------------ sign in with Google
# The **public** OAuth client id of a "Web application" in Google Cloud
# Console. No client secret is needed: the browser receives a signed ID token
# and the API verifies it against Google's public keys.
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------- the CORS
# The browser origins that may call the API — no trailing slash.
CORS_ORIGINS=https://localhost:8443

# --------------------------------------------------------------- the metrics
# The Prometheus endpoint (GET /api/metrics). Only reachable from inside the
# Docker network.
METRICS_ENABLED=true

# --------------------------------------------------------------- the backups
# Where the nightly backup goes.
S3_BUCKET=your-backup-bucket
S3_PREFIX=assetflow/backups
AWS_REGION=ap-south-1
# The credentials are never written here on the server — the EC2 instance
# uses an IAM role (see docs/AWS_SETUP.md). For a laptop you can export
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in your shell.
RETENTION_DAYS=14
BACKUP_DIR=/var/backups/assetflow

# ------------------------------------------------------------ the telemetry
# The Telegram bot that receives the alerts (@BotFather creates it).
TELEGRAM_BOT_TOKEN=123456789:replace-me
TELEGRAM_CHAT_ID=123456789

# ----------------------------------------------------------------- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-a-long-grafana-password

# ------------------------------------------------------------------ the edge
# The ports the edge listens on.
HTTP_PORT=80
HTTPS_PORT=443
