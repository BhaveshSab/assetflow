[Unit]
# Runs the backup every night at 02:30.
Description=Run the AssetFlow backup every night

[Timer]
OnCalendar=*-*-* 02:30:00
# If the server was off at 02:30, the backup runs as soon as it is back.
Persistent=true
RandomizedDelaySec=300
Unit=assetflow-backup.service

[Install]
WantedBy=timers.target
