// AssetFlow — Enterprise Asset & Resource Management System
// Prisma data model (the "keystone": every feature reads/writes these tables).
//
// Design notes for the team:
//  - One `User` table IS the employee directory. `role` is set here and ONLY
//    changed by an Admin (never at signup) — this enforces the spec's
//    "no self-assigned admin roles" rule.
//  - The asset lifecycle is the enum `AssetStatus`. Workflows (allocation,
//    maintenance, audit) transition assets between these states.
//  - History is kept as rows (Allocation, MaintenanceRequest, AuditItem, etc.)
//    so per-asset history is just a query, never a destructive update.

generator client {
  provider = "prisma-client-js"
  // Rust-free ("client") engine: the Prisma Client talks to Postgres through
  // a driver adapter (@prisma/adapter-neon or @prisma/adapter-pg) instead of
  // loading a platform-specific native query-engine binary. That keeps the
  // deployment artifact small and platform independent (no more
  // `binaryTargets` to keep in sync with the serverless runtime).
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  ASSET_MANAGER
  DEPARTMENT_HEAD
  EMPLOYEE
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

// The asset lifecycle state machine.
enum AssetStatus {
  AVAILABLE
  ALLOCATED
  RESERVED
  UNDER_MAINTENANCE
  LOST
  RETIRED
  DISPOSED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AllocationStatus {
  ACTIVE
  RETURNED
}

enum TransferStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum BookingStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum MaintenanceStatus {
  PENDING
  APPROVED
  REJECTED
  TECHNICIAN_ASSIGNED
  IN_PROGRESS
  RESOLVED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditCycleStatus {
  OPEN
  CLOSED
}

enum AuditResult {
  PENDING
  VERIFIED
  MISSING
  DAMAGED
}

enum NotificationType {
  ASSET_ASSIGNED
  ASSET_RETURNED
  TRANSFER_REQUESTED
  TRANSFER_APPROVED
  TRANSFER_REJECTED
  MAINTENANCE_RAISED
  MAINTENANCE_APPROVED
  MAINTENANCE_REJECTED
  MAINTENANCE_RESOLVED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  OVERDUE_RETURN
  AUDIT_ASSIGNED
  AUDIT_DISCREPANCY
  AUDIT_CLOSED
  USER_ROLE_CHANGED
}

// ---------------------------------------------------------------------------
// ORGANIZATION / IDENTITY
// ---------------------------------------------------------------------------

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  // Password sign-in is optional: an account created through "Sign in with
  // Google" has no password, and a Google identity is linked to an existing
  // password account on first use.
  passwordHash String?
  googleId     String?      @unique
  role         Role         @default(EMPLOYEE)
  status       RecordStatus @default(ACTIVE)

  // Optional profile picture. A URL, not an upload: the API never stores
  // binary blobs (see docs/DECISIONS.md), so the column is a link to an image
  // the user already hosts, validated as https on the way in.
  avatarUrl String?

  // Bumped whenever the password changes. The JWT carries the value it was
  // minted with (`ver`), and JwtStrategy rejects a token whose `ver` is behind
  // the row — which is how "change password" and "sign out everywhere" end
  // *other* sessions without a server-side session table.
  tokenVersion Int @default(0)

  credentialsChangedAt DateTime?

  departmentId String?
  department   Department? @relation("DepartmentMembers", fields: [departmentId], references: [id])

  // Departments this user heads (a Department Head).
  headedDepartments Department[] @relation("DepartmentHead")

  // Reverse relations
  attachments Attachment[]
  assetImports AssetImport[]
  allocationsHeld     Allocation[]         @relation("AllocationHolder")
  allocationsMade     Allocation[]         @relation("AllocatedBy")
  transfersRequested  TransferRequest[]    @relation("TransferRequestedBy")
  transfersApproved   TransferRequest[]    @relation("TransferApprovedBy")
  transfersTo         TransferRequest[]    @relation("TransferToUser")
  bookings            Booking[]
  maintenanceRaised   MaintenanceRequest[] @relation("MaintenanceRaisedBy")
  maintenanceApproved MaintenanceRequest[] @relation("MaintenanceApprovedBy")
  auditCyclesCreated  AuditCycle[]         @relation("AuditCycleCreatedBy")
  auditAssignments    AuditAssignment[]
  auditItemsChecked   AuditItem[]
  notifications       Notification[]
  activityLogs        ActivityLog[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([departmentId])
}

/**
 * A one-time password-reset link.
 *
 * Only the SHA-256 **hash** of the token is stored: a leaked database row
 * cannot be turned back into a working link. `usedAt` makes the token
 * single-use, and every new request deletes the previous outstanding ones so
 * an old e-mail stops working the moment a fresh one is asked for.
 */
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Department {
  id     String       @id @default(cuid())
  name   String       @unique
  status RecordStatus @default(ACTIVE)

  parentDepartmentId String?
  parentDepartment   Department?  @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments   Department[] @relation("DepartmentHierarchy")

  headId String?
  head   User?   @relation("DepartmentHead", fields: [headId], references: [id])

  members            User[]            @relation("DepartmentMembers")
  allocations        Allocation[]      @relation("AllocationDepartment")
  transfersTo        TransferRequest[] @relation("TransferToDepartment")
  auditCyclesInScope AuditCycle[]      @relation("AuditScopeDepartment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetCategory {
  id     String       @id @default(cuid())
  name   String       @unique
  status RecordStatus @default(ACTIVE)

  // Category-specific field *definitions*, e.g. [{ "key": "warrantyMonths", "type": "number" }].
  // The per-asset *values* live on Asset.customFieldValues.
  customFields Json?

  assets Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// ASSETS
// ---------------------------------------------------------------------------

model Asset {
  id                String         @id @default(cuid())
  assetTag          String         @unique // auto-generated, e.g. AF-0001
  name              String
  serialNumber      String?
  acquisitionDate   DateTime?
  acquisitionCost   Decimal?       @db.Decimal(12, 2) // for ranking/reports only, NOT accounting
  condition         AssetCondition @default(GOOD)
  location          String?
  photoUrl          String?
  documents         Json? // list of { name, url }
  isBookable        Boolean        @default(false) // "shared/bookable" flag
  status            AssetStatus    @default(AVAILABLE)
  customFieldValues Json?

  categoryId String
  category   AssetCategory @relation(fields: [categoryId], references: [id])

  attachments Attachment[]
  allocations         Allocation[]
  transferRequests    TransferRequest[]
  bookings            Booking[]
  maintenanceRequests MaintenanceRequest[]
  auditItems          AuditItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([location])
}

/// The single row that hands out asset tags (see the migration
/// 20261108090300_asset_tag_counter for why a counter row rather than a
/// sequence). Always read and written inside the caller's transaction, with
/// `SELECT … FOR UPDATE` on this row to serialise concurrent registrations.
model AssetTagCounter {
  id    Int    @id
  value BigInt @default(0)
}

// ---------------------------------------------------------------------------
// ALLOCATION & TRANSFER
// ---------------------------------------------------------------------------

model Allocation {
  id     String           @id @default(cuid())
  status AllocationStatus @default(ACTIVE)

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  // Allocated to an employee OR a department (at least one set).
  holderUserId String?
  holderUser   User?       @relation("AllocationHolder", fields: [holderUserId], references: [id])
  departmentId String?
  department   Department? @relation("AllocationDepartment", fields: [departmentId], references: [id])

  allocatedById String
  allocatedBy   User   @relation("AllocatedBy", fields: [allocatedById], references: [id])

  expectedReturnDate DateTime?
  allocatedAt        DateTime        @default(now())
  returnedAt         DateTime?
  checkInNotes       String? // condition notes captured on return
  conditionOnReturn  AssetCondition?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([status])
  @@index([holderUserId])

  // One ACTIVE allocation per asset is ALSO enforced by a partial unique index
  // created in migration 20261108090000_allocation_one_active_per_asset.
  // Prisma cannot express partial indexes, so it lives in raw SQL; do not drop
  // it with a manual migration.
}

model TransferRequest {
  id     String         @id @default(cuid())
  status TransferStatus @default(REQUESTED)

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  requestedById String
  requestedBy   User   @relation("TransferRequestedBy", fields: [requestedById], references: [id])

  // Where the asset should go.
  toUserId       String?
  toUser         User?       @relation("TransferToUser", fields: [toUserId], references: [id])
  toDepartmentId String?
  toDepartment   Department? @relation("TransferToDepartment", fields: [toDepartmentId], references: [id])

  approvedById String?
  approvedBy   User?   @relation("TransferApprovedBy", fields: [approvedById], references: [id])

  reason     String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([assetId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// RESOURCE BOOKING
// ---------------------------------------------------------------------------

model Booking {
  reminderVersion Int @default(0)
  id     String        @id @default(cuid())
  status BookingStatus @default(UPCOMING)

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  bookedById String
  bookedBy   User   @relation(fields: [bookedById], references: [id])

  startTime DateTime
  endTime   DateTime
  purpose   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Overlap validation runs in application logic AND is enforced by the
  // "Booking_no_overlap" EXCLUDE constraint created in migration
  // 20261108090100_booking_no_overlap (raw SQL — Prisma cannot express it).
  // This index keeps the "is there an existing booking in this window?" query fast.
  @@index([assetId, startTime, endTime])
  @@index([status])
}

// ---------------------------------------------------------------------------
// MAINTENANCE
// ---------------------------------------------------------------------------

model MaintenanceRequest {
  id       String              @id @default(cuid())
  status   MaintenanceStatus   @default(PENDING)
  priority MaintenancePriority @default(MEDIUM)

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  raisedById String
  raisedBy   User   @relation("MaintenanceRaisedBy", fields: [raisedById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("MaintenanceApprovedBy", fields: [approvedById], references: [id])

  description     String
  photoUrl        String?
  technicianName  String? // free-text technician assignment
  resolutionNotes String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([assetId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// AUDIT
// ---------------------------------------------------------------------------

model AuditCycle {
  id     String           @id @default(cuid())
  name   String
  status AuditCycleStatus @default(OPEN)

  // Scope: a department and/or a location, over a date range.
  scopeDepartmentId String?
  scopeDepartment   Department? @relation("AuditScopeDepartment", fields: [scopeDepartmentId], references: [id])
  scopeLocation     String?

  startDate DateTime
  endDate   DateTime

  createdById String
  createdBy   User   @relation("AuditCycleCreatedBy", fields: [createdById], references: [id])

  assignments AuditAssignment[]
  items       AuditItem[]

  createdAt DateTime  @default(now())
  closedAt  DateTime?
  updatedAt DateTime  @updatedAt
}

model AuditAssignment {
  id String @id @default(cuid())

  auditCycleId String
  auditCycle   AuditCycle @relation(fields: [auditCycleId], references: [id], onDelete: Cascade)

  auditorId String
  auditor   User   @relation(fields: [auditorId], references: [id])

  createdAt DateTime @default(now())

  @@unique([auditCycleId, auditorId])
}

model AuditItem {
  id     String      @id @default(cuid())
  result AuditResult @default(PENDING)

  auditCycleId String
  auditCycle   AuditCycle @relation(fields: [auditCycleId], references: [id], onDelete: Cascade)

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  auditedById String?
  auditedBy   User?   @relation(fields: [auditedById], references: [id])

  notes     String?
  auditedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([auditCycleId, assetId])
  @@index([result])
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS & ACTIVITY LOG
// ---------------------------------------------------------------------------

model Notification {
  dedupeKey String? @unique
  id      String           @id @default(cuid())
  type    NotificationType
  message String
  isRead  Boolean          @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Soft pointer to the entity that triggered this (no FK, so any table works).
  relatedEntityType String?
  relatedEntityId   String?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// Immutable "who did what, when" log. Rows are only ever inserted, never updated.
model ActivityLog {
  id String @id @default(cuid())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  action     String // e.g. "asset.allocated", "maintenance.approved"
  entityType String?
  entityId   String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  // The feed is read newest-first (ORDER BY createdAt DESC LIMIT 50).
  @@index([createdAt(sort: Desc)])
}

// Durable delivery source of truth; Redis jobs can be rebuilt from these rows.
model JobOutbox {
  traceparent String?
  retryEpoch Int @default(0)
  id String @id @default(cuid())
  topic String
  bookingId String
  version Int
  availableAt DateTime
  status String @default("PENDING")
  leaseUntil DateTime?
  attempts Int @default(0)
  lastError String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@unique([bookingId, version])
  @@index([status, availableAt, leaseUntil])
}

// Private objects: never expose object keys or public URLs through asset detail.
model Attachment {
  id String @id @default(cuid())
  assetId String
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy User @relation(fields: [uploadedById], references: [id])
  filename String
  contentType String
  size Int
  checksum String
  objectKey String @unique
  versionId String?
  status String @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([assetId, status])
}

// Validated immutable preview. Only its ID and retry epoch go into Redis.
model AssetImport {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  rows Json
  status String @default("DRAFT")
  total Int
  imported Int @default(0)
  attempts Int @default(0)
  retryEpoch Int @default(0)
  leaseUntil DateTime?
  lastError String?
  traceparent String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  @@index([status, leaseUntil])
  @@index([ownerId, createdAt])
}
