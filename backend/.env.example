# ---------------------------------------------------------------------------
# AssetFlow backend environment — TEMPLATE (safe to commit)
# Copy this to `.env` and fill in real values. `.env` itself is git-ignored.
#
# Every value below is validated at boot (see src/config/env.validation.ts):
# a missing/invalid value is reported with a clear message instead of failing
# later with a cryptic error. In production the API then answers 503 with the
# reason (and GET /api/health reports it) rather than crashing.
# ---------------------------------------------------------------------------

# Runtime mode: "development" | "test" | "production".
# In "production" the JWT secret must be a strong, unique value.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres connection string.
#   • Local Docker:  postgresql://assetflow:assetflow@localhost:5433/assetflow
#   • Neon (free):   postgresql://USER:PASSWORD@ep-xxx.neon.tech/assetflow?sslmode=require
# The driver is chosen automatically:
#   • direct  *.neon.tech  -> Neon WebSocket adapter (port 443)
#   • pooled  *-pooler.*   -> node-postgres (PgBouncer speaks plain Postgres)
#   • anything else        -> node-postgres
DATABASE_URL="postgresql://assetflow:assetflow@localhost:5433/assetflow"

# Direct (unpooled) URL — used for MIGRATIONS ONLY.
# Neon hands out two URLs: the pooled one (…-pooler.…, fine for the running
# API) and the direct one (ep-xxx.neon.tech). Prisma's migration engine
# cannot run through PgBouncer, so put the direct URL here and run:
#   npm run prisma:migrate
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.neon.tech/assetflow?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Secret used to sign JWT access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# MUST be >= 32 characters in production.
JWT_SECRET="change-me"

# How long a token stays valid. Any `ms`-style string or a time span
# ("15m", "24h", "7d").
JWT_EXPIRES_IN="7d"

# Optional: the public OAuth client id of a "Web application" in Google Cloud
# Console. The ID-token flow needs no client secret. When it is empty, the
# sign-in page hides Google instead of offering a dead button.
# GOOGLE_CLIENT_ID="1234567890-abc.apps.googleusercontent.com"

# bcrypt cost factor (4 = fastest, 12 = secure default, 15 = slowest).
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the API listens on. The Vite dev server proxies /api here.
PORT=4000

# Comma-separated list of allowed frontend origins (no trailing slash).
# Local:  http://localhost:5173,http://localhost:5174
# Prod:   https://your-app.vercel.app
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Global per-IP limit (all routes). Milliseconds / requests per window.
THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# Stricter limit for the endpoints that check a secret, create an account or
# send mail: sign-in, sign-up, forgot-password, reset-password,
# change-password. Spent per key (`login:<email>|<ip>`, `signup:<ip>`,
# `reset:<email>|<ip>`, …), never shared between the flows. Read on every call,
# so it can be tuned without a rebuild.
AUTH_THROTTLE_TTL=900000
AUTH_THROTTLE_LIMIT=10

# ---------------------------------------------------------------------------
# Password reset
# ---------------------------------------------------------------------------
# Where the reset link points. Must be an absolute URL: a relative value would
# produce a link that only works on the machine that generated it.
FRONTEND_URL="http://localhost:5173"

# dev  = write each message to MAIL_DIR (default ./var/mail) and print one log
#        line. Nothing leaves the machine; the link is in the file.
# smtp = send for real. SMTP_URL is then REQUIRED — the API refuses to boot
#        without it, because a reset flow that cannot send is worse than a
#        server that will not start.
MAIL_TRANSPORT=dev
# MAIL_FROM="AssetFlow <no-reply@your-domain.example>"
# SMTP_URL="smtps://user:app-password@smtp.example.com:465"

# ---------------------------------------------------------------------------
# First administrator (optional, one-shot)
# ---------------------------------------------------------------------------
# Sign-up always creates an EMPLOYEE, so an empty database has no admin. Set
# this to an address that has ALREADY signed up and restart: the API promotes
# it at boot, but only while the database has no active administrator. It never
# creates a user. Remove this line once it has run.
# BOOTSTRAP_ADMIN_EMAIL="you@your-domain.example"

# ---------------------------------------------------------------------------
# Optional shared store
# ---------------------------------------------------------------------------
# When REDIS_URL is set, the rate-limit counters and the auth attempt counters
# are kept in Redis: they are then shared by every instance and they
# survive a restart. Without it they live in the process (a restart clears
# the brute-force protection).
# REDIS_URL="redis://:password@localhost:6379"

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Exposes GET /api/metrics for Prometheus. Keep it OFF on a public
# deployment — the self-hosted stack (infra/) turns it on and only lets the
# internal Nginx reach it.
METRICS_ENABLED=false

# Separate long-lived worker, never a Vercel request handler.
JOBS_ENABLED=false
# JOBS_REDIS_URL=redis://:url-encoded-password@localhost:6380/0
# JOBS_METRICS_PORT=4001

# Phases 2–5: backend only. See docs/ASSET_EXTENSIONS.md; never VITE_ credentials.
ATTACHMENTS_ENABLED=false
ATTACHMENTS_BUCKET=
AWS_REGION=
OTEL_ENABLED=false
OTEL_SERVICE_NAME=assetflow-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=0.1
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=...
