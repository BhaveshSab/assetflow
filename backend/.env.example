# ---------------------------------------------------------------------------
# AssetFlow backend environment — TEMPLATE (safe to commit)
# Copy this to `.env` and fill in real values. `.env` itself is git-ignored.
#
# Every value below is validated at boot (see src/config/env.validation.ts):
# a missing/invalid value is reported with a clear message instead of failing
# later with a cryptic error. In production the API then answers 503 with the
# reason (and GET /api/health reports it) rather than crashing.
# ---------------------------------------------------------------------------

# Runtime mode: "development" | "test" | "production".
# In "production" the JWT secret must be a strong, unique value.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres connection string.
#   • Local Docker:  postgresql://assetflow:assetflow@localhost:5433/assetflow
#   • Neon (free):   postgresql://USER:PASSWORD@ep-xxx.neon.tech/assetflow?sslmode=require
# The driver is chosen automatically:
#   • direct  *.neon.tech  -> Neon WebSocket adapter (port 443)
#   • pooled  *-pooler.*   -> node-postgres (PgBouncer speaks plain Postgres)
#   • anything else        -> node-postgres
DATABASE_URL="postgresql://assetflow:assetflow@localhost:5433/assetflow"

# Direct (unpooled) URL — used for MIGRATIONS ONLY.
# Neon hands out two URLs: the pooled one (…-pooler.…, fine for the running
# API) and the direct one (ep-xxx.neon.tech). Prisma's migration engine
# cannot run through PgBouncer, so put the direct URL here and run:
#   npm run prisma:migrate
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.neon.tech/assetflow?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Secret used to sign JWT access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# MUST be >= 32 characters in production.
JWT_SECRET="change-me"

# How long a token stays valid. Any `ms`-style string or a time span
# ("15m", "24h", "7d").
JWT_EXPIRES_IN="7d"

# bcrypt cost factor (4 = fastest, 12 = secure default, 15 = slowest).
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Port the API listens on. The Vite dev server proxies /api here.
PORT=4000

# Comma-separated list of allowed frontend origins (no trailing slash).
# Local:  http://localhost:5173,http://localhost:5174
# Prod:   https://your-app.vercel.app
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Global per-IP limit (all routes). Milliseconds / requests per window.
THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# Stricter limit for the sign-in / sign-up endpoints (per account + IP).
AUTH_THROTTLE_TTL=900000
AUTH_THROTTLE_LIMIT=10

# ---------------------------------------------------------------------------
# Optional shared store
# ---------------------------------------------------------------------------
# When REDIS_URL is set, the rate-limit counters and the failed-sign-in
# counters are kept in Redis: they are then shared by every instance and they
# survive a restart. Without it they live in the process (a restart clears
# the brute-force protection).
# REDIS_URL="redis://:password@localhost:6379"

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Exposes GET /api/metrics for Prometheus. Keep it OFF on a public
# deployment — the self-hosted stack (infra/) turns it on and only lets the
# internal Nginx reach it.
METRICS_ENABLED=false
