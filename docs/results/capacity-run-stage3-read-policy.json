{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "01ReadRunDiagnostics",
      "Effect": "Allow",
      "Action": [
        "ec2:GetConsoleOutput",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeInstanceCreditSpecifications"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-2"
        }
      }
    }
  ]
}
