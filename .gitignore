node_modules
dist
dist-ssr
*.local
.vite

# Local env overrides (.env.example is the committed template)
.env
.env.local
.env.*.local

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Logs
logs
*.log
# …except the measurement transcripts: a number in a document is a claim, and
# the file that produced it is the evidence. (docs/results/README.md links to
# these directly; without this line every cited .log was silently untracked.)
!docs/results/*.log

# Freebuff local tooling
.freebuff/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build artifacts
*.tsbuildinfo

# TLS material and ACME challenges (never commit a private key)
infra/certs/
infra/certbot-www/
infra/textfile/

# Python validation caches
__pycache__/
*.pyc

# Capacity-run generated trust material and rendered payloads.
# These contain a private key and a bearer token. They are generated locally by
# infra/capacity-run/generate-trust.sh and must never be committed.
.capacity-run-trust/
*.capacity-run/
tls.key
tls.crt
evidence.token
trust.env
user-data.b64
user-data.rendered
