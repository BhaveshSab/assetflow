# Line endings are part of the contract here: these files are executed on
# Linux. A CRLF shebang fails with `env: 'bash\r': No such file or directory`,
# which is exactly what happens when a Windows checkout (core.autocrlf=true)
# is copied to the server.
* text=auto eol=lf

*.sh          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.conf        text eol=lf
*.template    text eol=lf
*.service     text eol=lf
*.timer       text eol=lf
Dockerfile    text eol=lf
*.pem         text eol=lf
*.sql         text eol=lf
